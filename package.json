{
  "name": "arteagamed",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter @arteagamed/web dev",
    "build": "pnpm --filter @arteagamed/web build",
    "typecheck": "pnpm --filter @arteagamed/web typecheck",
    "lint": "eslint frontend/src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "design:lint": "design.md lint DESIGN.md",
    "design:tokens": "node scripts/design-tokens.mjs",
    "design:check": "node scripts/design-tokens.mjs --check"
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  }
}
