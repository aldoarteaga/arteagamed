# Server
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Database (local dev — docker-compose)
DATABASE_URL=postgres://eart:eart_dev_password@localhost:5432/eart_dev

# Redis (local dev — docker-compose)
REDIS_URL=redis://localhost:6379

# AWS (local dev can use LocalStack or real AWS with limited perms)
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3
S3_DOCUMENTS_BUCKET=eart-documents-dev
S3_PRESIGN_EXPIRY_SECONDS=900

# Cognito
COGNITO_USER_POOL_ID=eu-west-1_XXXXXXXXX
COGNITO_CLIENT_ID=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_INTEGRAL=price_...
STRIPE_PRICE_CONTINUADA=price_...
STRIPE_PRICE_AVANZADA=price_...

# Notifications
NOTIFICATION_EMAIL=eduardo@arteagamed.com
